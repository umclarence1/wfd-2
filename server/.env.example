# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/wds
CLIENT_URL=http://localhost:5173
# Unique key when multiple sites share one MongoDB (e.g. wilberforcedataservice.com)
SITE_SETTINGS_KEY=wilberforcedataservice.com

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_PUBLIC_KEY=pk_test_your_key

# Email (Nodemailer) — Resend used first when RESEND_API_KEY is set
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Wilberforce Data Service <noreply@wds.com>
RESEND_API_KEY=

# SMS (Arkesel)
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID=WDS

# SMS (mNotify — legacy)
MNOTIFY_API_KEY=your-mnotify-api-key
MNOTIFY_SENDER_ID=WDS

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Provider API (legacy single provider)
PROVIDER_API_URL=https://api.provider.example.com
PROVIDER_API_KEY=your-provider-api-key

# Multi-provider routing (data bundles + AFA + checkers)
SMART_DATA_HUB_API_URL=https://smartdatahubgh.com/api/v1
SMART_DATA_HUB_API_KEY=
SMART_DATA_HUB_API_SECRET=
TOPDEALSGH_API_URL=https://www.topdealsgh.com/api/v1/agent
TOPDEALSGH_API_KEY=
TOPDEALSGH_SECRET_KEY=
FULFILLMENT_WEBHOOK_URL=

# Encryption key for API keys (32 chars)
ENCRYPTION_KEY=change-me-32-char-encryption-key!!

# Cron (Bearer token for /api/cron/* — Vercel Cron also accepted via x-vercel-cron)
CRON_SECRET=change-me-cron-secret

# Admin seed
ADMIN_EMAIL=admin@wds.com
ADMIN_PASSWORD=Admin@123456

# Admin login OTP (sent to this email after password is verified)
ADMIN_OTP_EMAIL=wilberforceboanu2002@gmail.com
ADMIN_OTP_PHONE=0595399837

# After deploy: set TopDealsGH webhook to https://<your-wds-server>/api/webhooks/topdeals
